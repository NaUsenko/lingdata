    <TIER ANNOTATOR="whisper" LINGUISTIC_TYPE_REF="imported-sep"
        PARTICIPANT="@del2007f" TIER_ID="asr@del2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a596"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>Я, Левдева Амандарья, не выражаю, что это другие сегодняшние записи. Мои речи будут использованы в учебных научных целях.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a597"
                TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>Санкт-Петербург 10 октября 2025 года. Но мы сейчас находимся в Москве.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a598"
                TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>Расскажи, пожалуйста, как выглядела квартира, в которой ты жила в санкт-петербурге.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a599"
                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>У нас была большая красивая квартира. У меня была своя комната. У меня были розовые стены с цветочками.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a600"
                TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>На мне очень нравилось. У меня был большой диван и свой рабочий стол. Жила я вместе с бабушкой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a601"
                TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>Еще у нас была большая гостиная. Там лежал колер персинский, очень красивый.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a602"
                TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>Ух, не было. Там в телевизоре стоял.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a603"
                TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>У каждого у меня была одна сестра. Три цветочки у каждого по комнате.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a604"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>Два туалет, три туалета. Один гостевой, один обычный и один с душем.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a605"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>Друзья, а где находился гостевой? Рядом с дверью. А обычный рядом только еще был.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a606"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>А сколько слов у вас получилось было?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a607"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>Сейчас.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a608"
                TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>Пять журналистов.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a609"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>Какая-то что-либо бывшая комната.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a610"
                TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>Это новостройка.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a611"
                TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>Два строя.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a612"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>Нормально. Прикольно. Мы еще в центре жили. На Васильевском мосте.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a613"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>А сейчас ты просто живешь в общаге?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a614"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>Я не в общаге живу, я не на бюджете. Я живу в Зяврегу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a615"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>Зяврегу очень далеко. И не такой красивый.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a616"
                TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>Но ты неплохо, наверное, поедешь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a617"
                TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>Не на бюджете.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a618"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>А с бабушкой жила в каком комнате?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a619"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>На одной кровати спальня.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a620"
                TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>Ну, своя комната, но с бабушкой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a621"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>Бабушку в подарок.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a622"
                TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>Это была не бабушка на комнате?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a623"
                TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>Нет, это была моя.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a624"
                TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>Просто бабушки не было в кровати?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a625"
                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>У нас был общий диван.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a626"
                TIME_SLOT_REF1="ts61" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>Мы так вместе на потомпорт.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a627"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>У вас есть домашний живот?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a628"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>Ну, у меня тут всю жизнь, я не знаю, кто только не жил.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a629"
                TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts68">
                <ANNOTATION_VALUE>Там типа и кролики, палочники.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a630"
                TIME_SLOT_REF1="ts69" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>Сорок, кстати, не было.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a631"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>О, палочки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a632"
                TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts74">
                <ANNOTATION_VALUE>Черепахи, кумики, улитки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a633"
                TIME_SLOT_REF1="ts75" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>Ну и фипси.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a634"
                TIME_SLOT_REF1="ts77" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>Ну и шасс.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a635"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts80">
                <ANNOTATION_VALUE>А какая собака?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a636"
                TIME_SLOT_REF1="ts81" TIME_SLOT_REF2="ts82">
                <ANNOTATION_VALUE>Ну я к ней беспокоена.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a637"
                TIME_SLOT_REF1="ts83" TIME_SLOT_REF2="ts84">
                <ANNOTATION_VALUE>Живет свою жизнь, пускай живет.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a638"
                TIME_SLOT_REF1="ts85" TIME_SLOT_REF2="ts86">
                <ANNOTATION_VALUE>То есть у вас сейчас только собака.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a639"
                TIME_SLOT_REF1="ts87" TIME_SLOT_REF2="ts100">
                <ANNOTATION_VALUE>А расскажи, пожалуйста, поподробнее про черепахи.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a640"
                TIME_SLOT_REF1="ts101" TIME_SLOT_REF2="ts138">
                <ANNOTATION_VALUE>Ну что, они все...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a641"
                TIME_SLOT_REF1="ts139" TIME_SLOT_REF2="ts193">
                <ANNOTATION_VALUE>Ну они все жили примерно до года.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a642"
                TIME_SLOT_REF1="ts194" TIME_SLOT_REF2="ts236">
                <ANNOTATION_VALUE>У нас дольше всех жил только кот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a643"
                TIME_SLOT_REF1="ts237" TIME_SLOT_REF2="ts304">
                <ANNOTATION_VALUE>Кот прожил до 16 лет.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a644"
                TIME_SLOT_REF1="ts305" TIME_SLOT_REF2="ts355">
                <ANNOTATION_VALUE>А кролик выпилился за три дня.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a645"
                TIME_SLOT_REF1="ts356" TIME_SLOT_REF2="ts410">
                <ANNOTATION_VALUE>Он наелся средством для битья посуды.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a646"
                TIME_SLOT_REF1="ts411" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>Не выдержал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a647"
                TIME_SLOT_REF1="ts429" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Палочники продержались три недели.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a648"
                TIME_SLOT_REF1="ts450" TIME_SLOT_REF2="ts456">
                <ANNOTATION_VALUE>Кумики.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a649"
                TIME_SLOT_REF1="ts457" TIME_SLOT_REF2="ts499">
                <ANNOTATION_VALUE>А, кумики 1,5 года, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a650"
                TIME_SLOT_REF1="ts500" TIME_SLOT_REF2="ts542">
                <ANNOTATION_VALUE>Одного утопили, второго задушили.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a651"
                TIME_SLOT_REF1="ts543" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>Никто из них не убил свою смерть.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a652"
                TIME_SLOT_REF1="ts580" TIME_SLOT_REF2="ts586">
                <ANNOTATION_VALUE>Как кошмар.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653"
                TIME_SLOT_REF1="ts587" TIME_SLOT_REF2="ts606">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654"
                TIME_SLOT_REF1="ts607" TIME_SLOT_REF2="ts622">
                <ANNOTATION_VALUE>Черепаха.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655"
                TIME_SLOT_REF1="ts623" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>Черепаху мы отдали на придержку нашим друзьям на то время,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656"
                TIME_SLOT_REF1="ts706" TIME_SLOT_REF2="ts723">
                <ANNOTATION_VALUE>когда мы за них заезжали.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657"
                TIME_SLOT_REF1="ts724" TIME_SLOT_REF2="ts781">
                <ANNOTATION_VALUE>И у них тоже была черепаха.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658"
                TIME_SLOT_REF1="ts782" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>Но у этой черепахи было воспаление легким.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659"
                TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts885">
                <ANNOTATION_VALUE>И она нашу черепаху заразила воспалением легким.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660"
                TIME_SLOT_REF1="ts886" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>Он тоже сдох.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661"
                TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts947">
                <ANNOTATION_VALUE>Попугай улетел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662"
                TIME_SLOT_REF1="ts948" TIME_SLOT_REF2="ts971">
                <ANNOTATION_VALUE>Вот так вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663"
                TIME_SLOT_REF1="ts972" TIME_SLOT_REF2="ts982">
                <ANNOTATION_VALUE>Друзья, расскажи мне, как...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664"
                TIME_SLOT_REF1="ts983" TIME_SLOT_REF2="ts1000">
                <ANNOTATION_VALUE>Подожди, как кролик съел средство?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665"
                TIME_SLOT_REF1="ts1001" TIME_SLOT_REF2="ts1035">
                <ANNOTATION_VALUE>По собственному желанию.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666"
                TIME_SLOT_REF1="ts1036" TIME_SLOT_REF2="ts1047">
                <ANNOTATION_VALUE>А где он нашел?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667"
                TIME_SLOT_REF1="ts1048" TIME_SLOT_REF2="ts1068">
                <ANNOTATION_VALUE>В библиотеке?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668"
                TIME_SLOT_REF1="ts1069" TIME_SLOT_REF2="ts1117">
                <ANNOTATION_VALUE>Ну нет, он у меня прыгал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669"
                TIME_SLOT_REF1="ts1118" TIME_SLOT_REF2="ts1141">
                <ANNOTATION_VALUE>Которого лета.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts1142" TIME_SLOT_REF2="ts1211">
                <ANNOTATION_VALUE>Во всей квартире он ходил.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671"
                TIME_SLOT_REF1="ts1212" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>Ну вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts1224" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>И залез он как-то под раковину.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673"
                TIME_SLOT_REF1="ts1263" TIME_SLOT_REF2="ts1342">
                <ANNOTATION_VALUE>Там лежали всякие губки, таблетки для машины, стирали больше средства.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674"
                TIME_SLOT_REF1="ts1343" TIME_SLOT_REF2="ts1376">
                <ANNOTATION_VALUE>Вот он решил сделать перекус.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675"
                TIME_SLOT_REF1="ts1377" TIME_SLOT_REF2="ts1420">
                <ANNOTATION_VALUE>И до утра улежал в библиотеке.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a676"
                TIME_SLOT_REF1="ts1421" TIME_SLOT_REF2="ts1434">
                <ANNOTATION_VALUE>Вот так вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a677"
                TIME_SLOT_REF1="ts1435" TIME_SLOT_REF2="ts1452">
                <ANNOTATION_VALUE>Печали.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678"
                TIME_SLOT_REF1="ts1453" TIME_SLOT_REF2="ts1505">
                <ANNOTATION_VALUE>Нет, у себя в морке коробочка.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a679"
                TIME_SLOT_REF1="ts1506" TIME_SLOT_REF2="ts1519">
                <ANNOTATION_VALUE>Это очень грустно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680"
                TIME_SLOT_REF1="ts1527" TIME_SLOT_REF2="ts1552">
                <ANNOTATION_VALUE>А хомякинтика, что с ней сделала?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681"
                TIME_SLOT_REF1="ts1553" TIME_SLOT_REF2="ts1580">
                <ANNOTATION_VALUE>Ну хомяка у меня есть сестра.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a682"
                TIME_SLOT_REF1="ts1581" TIME_SLOT_REF2="ts1589">
                <ANNOTATION_VALUE>Она была меньше и глупее.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a683"
                TIME_SLOT_REF1="ts1590" TIME_SLOT_REF2="ts1608">
                <ANNOTATION_VALUE>И одного она решила помыть.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a684"
                TIME_SLOT_REF1="ts1609" TIME_SLOT_REF2="ts1628">
                <ANNOTATION_VALUE>Она его взяла, начала мыть.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a685"
                TIME_SLOT_REF1="ts1629" TIME_SLOT_REF2="ts1647">
                <ANNOTATION_VALUE>Мыла долго, качественно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a686"
                TIME_SLOT_REF1="ts1648" TIME_SLOT_REF2="ts1662">
                <ANNOTATION_VALUE>Отмыла, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a687"
                TIME_SLOT_REF1="ts1667" TIME_SLOT_REF2="ts1687">
                <ANNOTATION_VALUE>Другого хомяка она решила обнять.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a688"
                TIME_SLOT_REF1="ts1688" TIME_SLOT_REF2="ts1698">
                <ANNOTATION_VALUE>Она обнимала его долго, качественно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689"
                TIME_SLOT_REF1="ts1707" TIME_SLOT_REF2="ts1713">
                <ANNOTATION_VALUE>Ну не вылежит.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690"
                TIME_SLOT_REF1="ts1714" TIME_SLOT_REF2="ts1723">
                <ANNOTATION_VALUE>Это старший сын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691"
                TIME_SLOT_REF1="ts1724" TIME_SLOT_REF2="ts1732">
                <ANNOTATION_VALUE>Наш.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692"
                TIME_SLOT_REF1="ts1733" TIME_SLOT_REF2="ts1758">
                <ANNOTATION_VALUE>А брат у тебя старший сын?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693"
                TIME_SLOT_REF1="ts1759" TIME_SLOT_REF2="ts1772">
                <ANNOTATION_VALUE>Тоже наш.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a694"
                TIME_SLOT_REF1="ts1773" TIME_SLOT_REF2="ts1783">
                <ANNOTATION_VALUE>Браты были.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a695"
                TIME_SLOT_REF1="ts1784" TIME_SLOT_REF2="ts1787">
                <ANNOTATION_VALUE>Десять.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a696"
                TIME_SLOT_REF1="ts1788" TIME_SLOT_REF2="ts1799">
                <ANNOTATION_VALUE>Нет, один был.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a697"
                TIME_SLOT_REF1="ts1800" TIME_SLOT_REF2="ts1806">
                <ANNOTATION_VALUE>Или двенадцать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a698"
                TIME_SLOT_REF1="ts1807" TIME_SLOT_REF2="ts1821">
                <ANNOTATION_VALUE>Нет, сестры девять, браты двенадцать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a699"
                TIME_SLOT_REF1="ts1822" TIME_SLOT_REF2="ts1831">
                <ANNOTATION_VALUE>Все.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a700"
                TIME_SLOT_REF1="ts1838" TIME_SLOT_REF2="ts1862">
                <ANNOTATION_VALUE>Расскажи, какие у тебя есть и были хомякинты.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a701"
                TIME_SLOT_REF1="ts1863" TIME_SLOT_REF2="ts1877">
                <ANNOTATION_VALUE>Вот в детстве и сейчас.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a702"
                TIME_SLOT_REF1="ts1883" TIME_SLOT_REF2="ts1887">
                <ANNOTATION_VALUE>Хомякинты?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a703"
                TIME_SLOT_REF1="ts1890" TIME_SLOT_REF2="ts1900">
                <ANNOTATION_VALUE>Ну я ходила на мазоплетение.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a704"
                TIME_SLOT_REF1="ts1901" TIME_SLOT_REF2="ts1910">
                <ANNOTATION_VALUE>Корзины.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a705"
                TIME_SLOT_REF1="ts1918" TIME_SLOT_REF2="ts1929">
                <ANNOTATION_VALUE>Это было очень забавно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a706"
                TIME_SLOT_REF1="ts1930" TIME_SLOT_REF2="ts1935">
                <ANNOTATION_VALUE>И это было прикольно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a707"
                TIME_SLOT_REF1="ts1936" TIME_SLOT_REF2="ts1953">
                <ANNOTATION_VALUE>Лоза она очень вкусно пахнет, когда она мокрая.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a708"
                TIME_SLOT_REF1="ts1954" TIME_SLOT_REF2="ts1966">
                <ANNOTATION_VALUE>Она прям полем каким-то таким.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a709"
                TIME_SLOT_REF1="ts1967" TIME_SLOT_REF2="ts1970">
                <ANNOTATION_VALUE>Очень прикольно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a710"
                TIME_SLOT_REF1="ts1971" TIME_SLOT_REF2="ts1981">
                <ANNOTATION_VALUE>Это в доме детского творчества.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a711"
                TIME_SLOT_REF1="ts1982" TIME_SLOT_REF2="ts2004">
                <ANNOTATION_VALUE>У меня подруга была, которая меня водила на все кружки мира.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a712"
                TIME_SLOT_REF1="ts2005" TIME_SLOT_REF2="ts2014">
                <ANNOTATION_VALUE>Потому что делать было нечего.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a713"
                TIME_SLOT_REF1="ts2015" TIME_SLOT_REF2="ts2037">
                <ANNOTATION_VALUE>И она брала меня с собой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a714"
                TIME_SLOT_REF1="ts2038" TIME_SLOT_REF2="ts2051">
                <ANNOTATION_VALUE>И вот мы с ней ходили на ориганы.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a715"
                TIME_SLOT_REF1="ts2052" TIME_SLOT_REF2="ts2057">
                <ANNOTATION_VALUE>На вот это плетение.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a716"
                TIME_SLOT_REF1="ts2058" TIME_SLOT_REF2="ts2065">
                <ANNOTATION_VALUE>На бати.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a717"
                TIME_SLOT_REF1="ts2073" TIME_SLOT_REF2="ts2081">
                <ANNOTATION_VALUE>Ну просто все, что можно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a718"
                TIME_SLOT_REF1="ts2082" TIME_SLOT_REF2="ts2102">
                <ANNOTATION_VALUE>В доме у меня всегда были корзины.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a719"
                TIME_SLOT_REF1="ts2103" TIME_SLOT_REF2="ts2116">
                <ANNOTATION_VALUE>Сплетенные всякие конфетницы.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a720"
                TIME_SLOT_REF1="ts2117" TIME_SLOT_REF2="ts2130">
                <ANNOTATION_VALUE>Для горячего.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a721"
                TIME_SLOT_REF1="ts2137" TIME_SLOT_REF2="ts2151">
                <ANNOTATION_VALUE>Из лазы?</ANNOTATION_VALUE>
