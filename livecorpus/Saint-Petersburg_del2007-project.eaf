        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a991"
                TIME_SLOT_REF1="ts3495" TIME_SLOT_REF2="ts3496">
                <ANNOTATION_VALUE>Мамушка, она жила половину времени в Питере.</ANNOTATION_VALUE>
