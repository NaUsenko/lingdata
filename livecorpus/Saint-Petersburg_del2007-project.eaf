        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a70"
                TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts417">
                <ANNOTATION_VALUE>∙∙ Не \вы̲держал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a71"
                TIME_SLOT_REF1="ts420" TIME_SLOT_REF2="ts444">
                <ANNOTATION_VALUE>∙∙∙∙ /Па̲лочники продержались три \неде̲ли.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts451" TIME_SLOT_REF2="ts458">
                <ANNOTATION_VALUE>∙∙∙∙ /Хомяки̲...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a73"
                TIME_SLOT_REF1="ts461" TIME_SLOT_REF2="ts501">
                <ANNOTATION_VALUE>∙∙ А, /хомяки̲ полтора \го̲да, да...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a74"
