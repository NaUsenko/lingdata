        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a722"
                TIME_SLOT_REF1="ts2152" TIME_SLOT_REF2="ts2159">
                <ANNOTATION_VALUE>Из лазы, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a723"
                TIME_SLOT_REF1="ts2160" TIME_SLOT_REF2="ts2187">
                <ANNOTATION_VALUE>Расскажи, пожалуйста, как происходит процесс плетения лазы.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a724"
                TIME_SLOT_REF1="ts2188" TIME_SLOT_REF2="ts2194">
                <ANNOTATION_VALUE>Так.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a725"
                TIME_SLOT_REF1="ts2195" TIME_SLOT_REF2="ts2204">
                <ANNOTATION_VALUE>Ну дается такая круглая штучка.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a726"
                TIME_SLOT_REF1="ts2205" TIME_SLOT_REF2="ts2237">
                <ANNOTATION_VALUE>И у нее по бокам вот такие воткнутые поля.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a727"
                TIME_SLOT_REF1="ts2238" TIME_SLOT_REF2="ts2256">
                <ANNOTATION_VALUE>Уберешь лазу и начинаешь вот так их облетать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a728"
                TIME_SLOT_REF1="ts2257" TIME_SLOT_REF2="ts2275">
                <ANNOTATION_VALUE>Облетаешь, облетаешь, лаза заканчивается.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a729"
                TIME_SLOT_REF1="ts2276" TIME_SLOT_REF2="ts2295">
                <ANNOTATION_VALUE>Вставляешь вторую и начинаешь так дальше.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a730"
                TIME_SLOT_REF1="ts2296" TIME_SLOT_REF2="ts2306">
                <ANNOTATION_VALUE>Вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a731"
                TIME_SLOT_REF1="ts2307" TIME_SLOT_REF2="ts2318">
                <ANNOTATION_VALUE>Это такой самый базовый зор.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a732"
                TIME_SLOT_REF1="ts2319" TIME_SLOT_REF2="ts2328">
                <ANNOTATION_VALUE>Тебе пресешь вверх.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a733"
                TIME_SLOT_REF1="ts2329" TIME_SLOT_REF2="ts2335">
                <ANNOTATION_VALUE>Вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a734"
                TIME_SLOT_REF1="ts2336" TIME_SLOT_REF2="ts2356">
                <ANNOTATION_VALUE>Когда корпус плета, извините, да, можно вроде как-то узор</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a735"
                TIME_SLOT_REF1="ts2357" TIME_SLOT_REF2="ts2363">
                <ANNOTATION_VALUE>на ней делать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a736"
                TIME_SLOT_REF1="ts2364" TIME_SLOT_REF2="ts2378">
                <ANNOTATION_VALUE>Но это получается сложно, как говорили вы в начале.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a737"
                TIME_SLOT_REF1="ts2379" TIME_SLOT_REF2="ts2389">
                <ANNOTATION_VALUE>Сплетите.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a738"
                TIME_SLOT_REF1="ts2390" TIME_SLOT_REF2="ts2397">
                <ANNOTATION_VALUE>Пятьдесят корзин.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a739"
                TIME_SLOT_REF1="ts2398" TIME_SLOT_REF2="ts2410">
                <ANNOTATION_VALUE>Потом еще пятьдесят.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a740"
                TIME_SLOT_REF1="ts2411" TIME_SLOT_REF2="ts2427">
                <ANNOTATION_VALUE>Ну может еще пятьдесят.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a741"
                TIME_SLOT_REF1="ts2428" TIME_SLOT_REF2="ts2439">
                <ANNOTATION_VALUE>И там будет узор.</ANNOTATION_VALUE>
