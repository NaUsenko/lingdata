    <TIER ANNOTATOR="@amu2007f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@amu2007f" PARTICIPANT="@amu2007f" TIER_ID="gestComment@amu2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3363" ANNOTATION_REF="a3359">
                <ANNOTATION_VALUE>я думаю, что это именно удивление выражено смехом (= очень нервный смех),  и поскольку смех быстро прекращается, это именно жест-адаптор, а не "настоящий" смех</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3370" ANNOTATION_REF="a3367">
                <ANNOTATION_VALUE>трясет ногой от стреса -- жест адаптор, размечаю между двумя другими, так как он меньше семантически нагружен</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3381" ANNOTATION_REF="a3377">
                <ANNOTATION_VALUE>вот тут именно смех-адаптор как реакция на шокирующую информацию, его маркер - попытка взять себя в руки и краткая (2с) продолжительность</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2982" ANNOTATION_REF="a2978">
                <ANNOTATION_VALUE>я выбирала между адаптором (неосознанно откидываюсь назад и отвожу голову) и прагматическим (предлагаю Даше рассказать), думаю, что это ближе к первому</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3392" ANNOTATION_REF="a3388">
                <ANNOTATION_VALUE>какое-то легкое пожимание плечами и обращенность головы к собеседнице</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3406" ANNOTATION_REF="a3400">
                <ANNOTATION_VALUE>вот это опять смех-адаптор, в отличие от предыдущего смеха, где я себя не стараюсь с помощью такого выражения удивления сдержать</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3463" ANNOTATION_REF="a3460">
                <ANNOTATION_VALUE>сильно отличается движение головы от следующего жеста, поэтому выделяю в отдельный. Сначала задумываюсь (типа какой вопрос задать), а потом вспоминаю "круглую штучку"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
