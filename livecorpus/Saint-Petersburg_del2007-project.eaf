        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a745"
                TIME_SLOT_REF1="ts2472" TIME_SLOT_REF2="ts2481">
                <ANNOTATION_VALUE>Но надо плетать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a746"
                TIME_SLOT_REF1="ts2482" TIME_SLOT_REF2="ts2495">
                <ANNOTATION_VALUE>Ну в принципе.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a747"
                TIME_SLOT_REF1="ts2496" TIME_SLOT_REF2="ts2501">
                <ANNOTATION_VALUE>Ну это прикольно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a748"
                TIME_SLOT_REF1="ts2502" TIME_SLOT_REF2="ts2507">
                <ANNOTATION_VALUE>Медитативно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a749"
                TIME_SLOT_REF1="ts2508" TIME_SLOT_REF2="ts2525">
                <ANNOTATION_VALUE>Сидишь, пройдешь, пройдешь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a750"
                TIME_SLOT_REF1="ts2526" TIME_SLOT_REF2="ts2552">
                <ANNOTATION_VALUE>Дома-то зимой сколько тебе?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a751"
                TIME_SLOT_REF1="ts2553" TIME_SLOT_REF2="ts2569">
                <ANNOTATION_VALUE>Ну, в течение года наверное.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a752"
                TIME_SLOT_REF1="ts2570" TIME_SLOT_REF2="ts2587">
                <ANNOTATION_VALUE>Как зимой?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a753"
                TIME_SLOT_REF1="ts2588" TIME_SLOT_REF2="ts2603">
                <ANNOTATION_VALUE>А куда ты их потом сидела?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a754"
                TIME_SLOT_REF1="ts2604" TIME_SLOT_REF2="ts2612">
                <ANNOTATION_VALUE>Дома.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a755"
                TIME_SLOT_REF1="ts2613" TIME_SLOT_REF2="ts2635">
                <ANNOTATION_VALUE>То есть у вас прям даром в доме-то зимой?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a756"
                TIME_SLOT_REF1="ts2636" TIME_SLOT_REF2="ts2645">
                <ANNOTATION_VALUE>Ну было да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a757"
                TIME_SLOT_REF1="ts2646" TIME_SLOT_REF2="ts2658">
                <ANNOTATION_VALUE>Сейчас наверное конечно на дачу много свезли.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a758"
                TIME_SLOT_REF1="ts2659" TIME_SLOT_REF2="ts2667">
                <ANNOTATION_VALUE>Но ну да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a759"
                TIME_SLOT_REF1="ts2668" TIME_SLOT_REF2="ts2685">
                <ANNOTATION_VALUE>А как ты их использовала?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a760"
                TIME_SLOT_REF1="ts2686" TIME_SLOT_REF2="ts2701">
                <ANNOTATION_VALUE>То есть наверное пригорячая еще как можно?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a761"
                TIME_SLOT_REF1="ts2702" TIME_SLOT_REF2="ts2720">
                <ANNOTATION_VALUE>Ну, ну как ветки засыпала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a762"
                TIME_SLOT_REF1="ts2721" TIME_SLOT_REF2="ts2742">
                <ANNOTATION_VALUE>Там какие-то цветочки можно было посадить.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a763"
                TIME_SLOT_REF1="ts2743" TIME_SLOT_REF2="ts2751">
                <ANNOTATION_VALUE>Слегка шпотик поставить.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a764"
                TIME_SLOT_REF1="ts2752" TIME_SLOT_REF2="ts2765">
                <ANNOTATION_VALUE>И без ручки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a765"
                TIME_SLOT_REF1="ts2766" TIME_SLOT_REF2="ts2774">
                <ANNOTATION_VALUE>Тут карандаши.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a766"
                TIME_SLOT_REF1="ts2775" TIME_SLOT_REF2="ts2781">
                <ANNOTATION_VALUE>Вот ножи.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a767"
                TIME_SLOT_REF1="ts2782" TIME_SLOT_REF2="ts2787">
                <ANNOTATION_VALUE>Дома.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a768"
                TIME_SLOT_REF1="ts2788" TIME_SLOT_REF2="ts2817">
                <ANNOTATION_VALUE>Ну то есть куда только эту карандаши засыпать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a769"
                TIME_SLOT_REF1="ts2818" TIME_SLOT_REF2="ts2829">
                <ANNOTATION_VALUE>А вот круглая штучка.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a770"
                TIME_SLOT_REF1="ts2830" TIME_SLOT_REF2="ts2840">
                <ANNOTATION_VALUE>С которой начинается процесс плетения.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a771"
                TIME_SLOT_REF1="ts2841" TIME_SLOT_REF2="ts2854">
                <ANNOTATION_VALUE>Ее тоже нужно себе сделать?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a772"
                TIME_SLOT_REF1="ts2855" TIME_SLOT_REF2="ts2877">
                <ANNOTATION_VALUE>Не, это давай.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a773"
                TIME_SLOT_REF1="ts2878" TIME_SLOT_REF2="ts2898">
                <ANNOTATION_VALUE>Ну это просто деревяшка.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a774"
                TIME_SLOT_REF1="ts2899" TIME_SLOT_REF2="ts2921">
                <ANNOTATION_VALUE>Никак бы особо.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a775"
                TIME_SLOT_REF1="ts2922" TIME_SLOT_REF2="ts2930">
                <ANNOTATION_VALUE>Не выпилешь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a776"
                TIME_SLOT_REF1="ts2931" TIME_SLOT_REF2="ts2943">
                <ANNOTATION_VALUE>А вот эти которые корни по бокам.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a777"
                TIME_SLOT_REF1="ts2944" TIME_SLOT_REF2="ts2953">
                <ANNOTATION_VALUE>Они как-то спрятаны.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a778"
                TIME_SLOT_REF1="ts2954" TIME_SLOT_REF2="ts2971">
                <ANNOTATION_VALUE>Там такие глубления.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a779"
                TIME_SLOT_REF1="ts2972" TIME_SLOT_REF2="ts2986">
                <ANNOTATION_VALUE>Ничего дырки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a780"
                TIME_SLOT_REF1="ts2987" TIME_SLOT_REF2="ts3005">
                <ANNOTATION_VALUE>Вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a781"
                TIME_SLOT_REF1="ts3006" TIME_SLOT_REF2="ts3012">
                <ANNOTATION_VALUE>Просто вставляешь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a782"
                TIME_SLOT_REF1="ts3013" TIME_SLOT_REF2="ts3023">
                <ANNOTATION_VALUE>Подходишь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a783"
                TIME_SLOT_REF1="ts3024" TIME_SLOT_REF2="ts3040">
                <ANNOTATION_VALUE>Находишь по диаметру оружия.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a784"
                TIME_SLOT_REF1="ts3041" TIME_SLOT_REF2="ts3050">
                <ANNOTATION_VALUE>Именно палки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a785"
                TIME_SLOT_REF1="ts3051" TIME_SLOT_REF2="ts3069">
                <ANNOTATION_VALUE>Ну палки да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a786"
                TIME_SLOT_REF1="ts3070" TIME_SLOT_REF2="ts3080">
                <ANNOTATION_VALUE>Пустоть в тыльку.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a787"
                TIME_SLOT_REF1="ts3081" TIME_SLOT_REF2="ts3085">
                <ANNOTATION_VALUE>И все.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a788"
                TIME_SLOT_REF1="ts3086" TIME_SLOT_REF2="ts3090">
                <ANNOTATION_VALUE>Ой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789"
                TIME_SLOT_REF1="ts3091" TIME_SLOT_REF2="ts3092">
                <ANNOTATION_VALUE>А на бате?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790"
                TIME_SLOT_REF1="ts3093" TIME_SLOT_REF2="ts3094">
                <ANNOTATION_VALUE>Тоже в ежедневную?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a791"
                TIME_SLOT_REF1="ts3095" TIME_SLOT_REF2="ts3096">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
