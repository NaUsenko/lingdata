    <TIER ANNOTATOR="@amu2007f" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@del2007f" PARTICIPANT="@del2007f" TIER_ID="gestComment@del2007f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1139" ANNOTATION_REF="a1134">
                <ANNOTATION_VALUE>чешет шею</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1147" ANNOTATION_REF="a1140">
                <ANNOTATION_VALUE>чешет заднюю часть шеи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1162" ANNOTATION_REF="a1152">
                <ANNOTATION_VALUE>запрокинуть голову назад</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1159" ANNOTATION_REF="a1155">
                <ANNOTATION_VALUE>кивнуть головой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1177" ANNOTATION_REF="a1172">
                <ANNOTATION_VALUE>кивнуть - акцент на длительности жизни хомяков</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1178" ANNOTATION_REF="a1175">
                <ANNOTATION_VALUE>кивнуть - подтвердить сказанное</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1185" ANNOTATION_REF="a1179">
                <ANNOTATION_VALUE>загибаются именно два пальца как акцент на 2 хомяках</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3355" ANNOTATION_REF="a3352">
                <ANNOTATION_VALUE>есть еще жест-адаптор "беспокойство" в руках, но основная семантическая нагрузка все же на голове</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1190" ANNOTATION_REF="a1188">
                <ANNOTATION_VALUE>поднять и опустить руки, чтобы подчеркнуть "тоже"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1205" ANNOTATION_REF="a1198">
                <ANNOTATION_VALUE>кисти сдвигаются к телу - акцент на "нашу"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1212" ANNOTATION_REF="a1209">
                <ANNOTATION_VALUE>продолжение общего перечисления животных</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3474" ANNOTATION_REF="a1213">
                <ANNOTATION_VALUE>видимо, она грустит из-за животных (?), на мой взгляд это не для установки связи с собеседником жест, что-то ближе к адаптору</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1217" ANNOTATION_REF="a1216">
                <ANNOTATION_VALUE>скорее всего, девушка перекладывает волосы от стресса, а не потому что они ей мешают</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1224" ANNOTATION_REF="a1218">
                <ANNOTATION_VALUE>кивок и пожимание плечами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2994" ANNOTATION_REF="a2990">
                <ANNOTATION_VALUE>прагматический, тк Даша отвечает на поставленный вопрос, но не общепринятым мотанием головой, а некоторым полукивком-полунаклоном головы</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1283" ANNOTATION_REF="a1278">
                <ANNOTATION_VALUE>наклонить голову и поднять плечо сопровождают оправдание почему кролик бегал по квартире</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1229" ANNOTATION_REF="a1226">
                <ANNOTATION_VALUE>кисти двигаются именно на слове "всей", указывая на квартиру</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1236" ANNOTATION_REF="a1233">
                <ANNOTATION_VALUE>у кивка две функции: поддержать ритм фразы и задуматься, заполнить паузу хезитации</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1248" ANNOTATION_REF="a1242">
                <ANNOTATION_VALUE>расслабленное короткое движение рукой вниз для помощи себе в речи</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1254" ANNOTATION_REF="a1246">
                <ANNOTATION_VALUE>указание на референт - машину</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1255" ANNOTATION_REF="a1249">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1262" ANNOTATION_REF="a1259">
                <ANNOTATION_VALUE>губы, сжатые таким образом, в обществе принято ассоциировать с огорчением</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3001" ANNOTATION_REF="a2938">
                <ANNOTATION_VALUE>думаю, акцент именно на подтверждении, кивок как бы говорит "да, [есть сестра]"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2959" ANNOTATION_REF="a2957">
                <ANNOTATION_VALUE>движение плечами и кивок подчеркивают итог, то есть, думаю, это опять выделение, усиление значения, которое называется в МУРКО "подчеркнуть эмфазу"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2965" ANNOTATION_REF="a2962">
                <ANNOTATION_VALUE>поджимает губы и поднимает глаза наверх -- явно не случайный жест головой, а что-то со значением вспомнить/задуматься</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2973" ANNOTATION_REF="a2969">
                <ANNOTATION_VALUE>возможно, сцепленные руки - изобразительный жест ("вот как она его обнимала"), но, наверное, это тоже подчеркивает эмфазу ( =усиливает значение)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2977" ANNOTATION_REF="a2974">
                <ANNOTATION_VALUE>думаю, кивок обозначает "вот так это все было", что-то близкое к "конец истории", т.е. завершение рассказа</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3021" ANNOTATION_REF="a3017">
                <ANNOTATION_VALUE>кивок имеет значение "да", на мой взгляд. Значит, это подверждение, может быть также, что это продолжение-перечисление (и брат младший, и сестра)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3034" ANNOTATION_REF="a3031">
                <ANNOTATION_VALUE>думаю, кивок здесь именно в прагматической функции: Даша выделяет мне, сколько в итоге лет брату</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3038" ANNOTATION_REF="a3035">
                <ANNOTATION_VALUE>основное значение жеста заключено в руках: противопоставление сестры и брата</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3067" ANNOTATION_REF="a3065">
                <ANNOTATION_VALUE>в целях лаконичности подписала "объекты", а не кружки, тк с таким же успехом это могло бы быть "всё что-то другое"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3108" ANNOTATION_REF="a3105">
                <ANNOTATION_VALUE>мне кажется нога тут не жест, так как она могла просто затечь, а вот волосы Даша явно перебирает нервно</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3158" ANNOTATION_REF="a3153">
                <ANNOTATION_VALUE>отделяю конец этого на первый взгляд единого жеста, тк он имеет другую конфигурацию рук и значение "завершения"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3162" ANNOTATION_REF="a3159">
                <ANNOTATION_VALUE>в МУРКО случаи, когда в воздухе прямо в разговоре вводится какое-то понятие размечены "общеуказательным", поэтому тут я делаю так же</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3287" ANNOTATION_REF="a3220">
                <ANNOTATION_VALUE>кажется, что кивок в прямом значении "да" это именно эмблема, а не прагматика</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3268" ANNOTATION_REF="a3260">
                <ANNOTATION_VALUE>считаю, что это уже следующий жест из-за явно отличающегося положения головы, другого движения плечом, рукой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
