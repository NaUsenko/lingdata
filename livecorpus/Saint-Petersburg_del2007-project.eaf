        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993"
                TIME_SLOT_REF1="ts3499" TIME_SLOT_REF2="ts3500">
                <ANNOTATION_VALUE>Она спала надо мы, одевали.</ANNOTATION_VALUE>
