        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a743"
                TIME_SLOT_REF1="ts2450" TIME_SLOT_REF2="ts2454">
                <ANNOTATION_VALUE>Ну ручку надо сделать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a744"
                TIME_SLOT_REF1="ts2455" TIME_SLOT_REF2="ts2471">
                <ANNOTATION_VALUE>Ручку тут тоже как-то бодрено делается.</ANNOTATION_VALUE>
