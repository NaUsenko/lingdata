        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a799"
                TIME_SLOT_REF1="ts690" TIME_SLOT_REF2="ts691">
                <ANNOTATION_VALUE>В этом номер творчества.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a800"
                TIME_SLOT_REF1="ts692" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>И потом мы шли на возблетение.</ANNOTATION_VALUE>
