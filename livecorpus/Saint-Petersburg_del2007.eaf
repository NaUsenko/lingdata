        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a653"
                TIME_SLOT_REF1="ts212" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a654"
                TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>Черепаха.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a655"
                TIME_SLOT_REF1="ts221" TIME_SLOT_REF2="ts238">
                <ANNOTATION_VALUE>Черепаху мы отдали на придержку нашим друзьям на то время,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a656"
                TIME_SLOT_REF1="ts239" TIME_SLOT_REF2="ts242">
                <ANNOTATION_VALUE>когда мы за них заезжали.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a657"
                TIME_SLOT_REF1="ts243" TIME_SLOT_REF2="ts254">
                <ANNOTATION_VALUE>И у них тоже была черепаха.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a658"
                TIME_SLOT_REF1="ts255" TIME_SLOT_REF2="ts262">
                <ANNOTATION_VALUE>Но у этой черепахи было воспаление легким.</ANNOTATION_VALUE>
