            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a797"
                TIME_SLOT_REF1="ts686" TIME_SLOT_REF2="ts687">
