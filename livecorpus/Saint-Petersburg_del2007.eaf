        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a789"
                TIME_SLOT_REF1="ts670" TIME_SLOT_REF2="ts671">
                <ANNOTATION_VALUE>А на бате?</ANNOTATION_VALUE>
