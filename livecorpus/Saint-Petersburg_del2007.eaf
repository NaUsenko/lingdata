        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1037"
                TIME_SLOT_REF1="ts1166" TIME_SLOT_REF2="ts1167">
                <ANNOTATION_VALUE>Вторая семья у меня был один мальчик, тоже очень милый, Лемашка, ему было два года тоже.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1038"
                TIME_SLOT_REF1="ts1168" TIME_SLOT_REF2="ts1169">
                <ANNOTATION_VALUE>И он был менее самостоятельный, я с ним в основном гуляла.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1039"
                TIME_SLOT_REF1="ts1170" TIME_SLOT_REF2="ts1171">
                <ANNOTATION_VALUE>То есть я, ну, вот в выходные я с ним приходила к одиннадцати, и уже в одиннадцать уходила домой вечером.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1040"
                TIME_SLOT_REF1="ts1172" TIME_SLOT_REF2="ts1173">
                <ANNOTATION_VALUE>То есть мы там в 12 часов, по десять, по двенадцать часов просто на улицу проводили, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1041"
                TIME_SLOT_REF1="ts1174" TIME_SLOT_REF2="ts1175">
                <ANNOTATION_VALUE>Ну, это было когда тепло.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1042"
                TIME_SLOT_REF1="ts1176" TIME_SLOT_REF2="ts1177">
                <ANNOTATION_VALUE>То есть мы начинали ездить домой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1043"
                TIME_SLOT_REF1="ts1178" TIME_SLOT_REF2="ts1179">
                <ANNOTATION_VALUE>У него родители всегда были дома, мне было как-то не очень комфортно играть с ним.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1044"
                TIME_SLOT_REF1="ts1180" TIME_SLOT_REF2="ts1181">
                <ANNOTATION_VALUE>В общем, они на выходные, или они...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1045"
                TIME_SLOT_REF1="ts1182" TIME_SLOT_REF2="ts1183">
                <ANNOTATION_VALUE>Это были очень богатые люди, и им...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1046"
                TIME_SLOT_REF1="ts1184" TIME_SLOT_REF2="ts1185">
                <ANNOTATION_VALUE>Ну, я была такой, типа, отговорящим тютеров довела.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1047"
                TIME_SLOT_REF1="ts1186" TIME_SLOT_REF2="ts1187">
                <ANNOTATION_VALUE>То есть я с ним только на английском болтала, и он, типа, должен так был приглашать язык.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1048"
                TIME_SLOT_REF1="ts1188" TIME_SLOT_REF2="ts1189">
                <ANNOTATION_VALUE>То есть они на эти вы никакого не нашли, а вот...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1049"
                TIME_SLOT_REF1="ts1190" TIME_SLOT_REF2="ts1191">
                <ANNOTATION_VALUE>Ну, я неплохо говорю, и поэтому подошла к этому должности.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1050"
                TIME_SLOT_REF1="ts1192" TIME_SLOT_REF2="ts1193">
                <ANNOTATION_VALUE>Вот. Ну, видимо, что он так питал язык, как-то в среду.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1051"
                TIME_SLOT_REF1="ts1194" TIME_SLOT_REF2="ts1195">
                <ANNOTATION_VALUE>Но они его хотели в прескулок дать, английский, и как-то чуть-чуть его погрузить для этого.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1052"
                TIME_SLOT_REF1="ts1196" TIME_SLOT_REF2="ts1197">
                <ANNOTATION_VALUE>Вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1053"
                TIME_SLOT_REF1="ts1198" TIME_SLOT_REF2="ts1199">
                <ANNOTATION_VALUE>Два года.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1054"
                TIME_SLOT_REF1="ts1200" TIME_SLOT_REF2="ts1201">
                <ANNOTATION_VALUE>Да, два, два и три.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1055"
                TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1203">
                <ANNOTATION_VALUE>Ты буквально в английский язык.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1056"
                TIME_SLOT_REF1="ts1204" TIME_SLOT_REF2="ts1205">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1057"
                TIME_SLOT_REF1="ts1206" TIME_SLOT_REF2="ts1207">
                <ANNOTATION_VALUE>Ну, вообще, я там же как с языком читаю.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1058"
                TIME_SLOT_REF1="ts1208" TIME_SLOT_REF2="ts1209">
                <ANNOTATION_VALUE>А я, кстати, не помню, когда считалась.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1059"
                TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1211">
                <ANNOTATION_VALUE>Ну, вот его папа мне говорила, что там вроде после трех, либо уже, типа, прям с нуля с рождения.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1060"
                TIME_SLOT_REF1="ts1212" TIME_SLOT_REF2="ts1213">
                <ANNOTATION_VALUE>Я, как бы сказать, пока что не шарила.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1061"
                TIME_SLOT_REF1="ts1214" TIME_SLOT_REF2="ts1215">
                <ANNOTATION_VALUE>Ну, вот так. Это он мне рассказал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1062"
                TIME_SLOT_REF1="ts1216" TIME_SLOT_REF2="ts1217">
                <ANNOTATION_VALUE>Ну, они были стоматологи, у них там, типа, своя клиника косметологическая, стоматологическая.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1063"
                TIME_SLOT_REF1="ts1218" TIME_SLOT_REF2="ts1219">
                <ANNOTATION_VALUE>Ну, то есть они русские, да, они из Москвы.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1064"
                TIME_SLOT_REF1="ts1220" TIME_SLOT_REF2="ts1221">
                <ANNOTATION_VALUE>Ну, у меня там прям холи-ли-ли-ли.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1065"
                TIME_SLOT_REF1="ts1222" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>Они говорят, Даша, ну, тебе в какой день дома прийти на этой неделе?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1066"
                TIME_SLOT_REF1="ts1224" TIME_SLOT_REF2="ts1225">
                <ANNOTATION_VALUE>Я говорю, ну, могу тогда и тогда.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1067"
                TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1227">
                <ANNOTATION_VALUE>Ну, приходи. Сколько часов хочешь посидеть сегодня?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1068"
                TIME_SLOT_REF1="ts1228" TIME_SLOT_REF2="ts1229">
                <ANNOTATION_VALUE>Я говорю, ну, давайте там до одиннадцати. Ну, и оставайся.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1069"
                TIME_SLOT_REF1="ts1230" TIME_SLOT_REF2="ts1231">
                <ANNOTATION_VALUE>Ору. Ору.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1070"
                TIME_SLOT_REF1="ts1232" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>Господи русский, еда у вас была какая-то или нет?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1071"
                TIME_SLOT_REF1="ts1234" TIME_SLOT_REF2="ts1235">
                <ANNOTATION_VALUE>Ну, вот еду мне и их мама иногда, ну, она чаек мне наливала, конфетки заказала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1072"
                TIME_SLOT_REF1="ts1236" TIME_SLOT_REF2="ts1237">
                <ANNOTATION_VALUE>А, вот, конфетки в Грузии, типа, не продаются.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1073"
                TIME_SLOT_REF1="ts1238" TIME_SLOT_REF2="ts1239">
                <ANNOTATION_VALUE>Знаешь, такие портыновые бомбарчики.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1074"
                TIME_SLOT_REF1="ts1240" TIME_SLOT_REF2="ts1241">
                <ANNOTATION_VALUE>Она их заказывала на Вайлберси специально для себя.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1075"
                TIME_SLOT_REF1="ts1242" TIME_SLOT_REF2="ts1243">
                <ANNOTATION_VALUE>И она меня ими кормила.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1076"
                TIME_SLOT_REF1="ts1244" TIME_SLOT_REF2="ts1245">
                <ANNOTATION_VALUE>Думаю, господи, она такая хорошая, реально, просто ангел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1077"
                TIME_SLOT_REF1="ts1246" TIME_SLOT_REF2="ts1247">
                <ANNOTATION_VALUE>То есть ты с ним двенадцать пятьсот год на улице?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1078"
                TIME_SLOT_REF1="ts1248" TIME_SLOT_REF2="ts1249">
                <ANNOTATION_VALUE>Он, а ему давали там рюкзак про провизии.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1079"
                TIME_SLOT_REF1="ts1250" TIME_SLOT_REF2="ts1251">
                <ANNOTATION_VALUE>Да. У него всегда были яблочки порезанные.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1080"
                TIME_SLOT_REF1="ts1252" TIME_SLOT_REF2="ts1253">
                <ANNOTATION_VALUE>Он меня ими угощал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1081"
                TIME_SLOT_REF1="ts1254" TIME_SLOT_REF2="ts1255">
                <ANNOTATION_VALUE>Что? Ну, какие-то пюрешки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1082"
                TIME_SLOT_REF1="ts1256" TIME_SLOT_REF2="ts1257">
                <ANNOTATION_VALUE>Творожки.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1083"
                TIME_SLOT_REF1="ts1258" TIME_SLOT_REF2="ts1259">
                <ANNOTATION_VALUE>Что-то такое.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1084"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1261">
                <ANNOTATION_VALUE>Макароны.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1085"
                TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1263">
                <ANNOTATION_VALUE>Он не голодал, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1086"
                TIME_SLOT_REF1="ts1264" TIME_SLOT_REF2="ts1265">
                <ANNOTATION_VALUE>Ко мне еще, как раз в теплое время, приходили баба с бабушкой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1087"
                TIME_SLOT_REF1="ts1266" TIME_SLOT_REF2="ts1267">
                <ANNOTATION_VALUE>Это было прямо в моем районе.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1088"
                TIME_SLOT_REF1="ts1268" TIME_SLOT_REF2="ts1269">
                <ANNOTATION_VALUE>Я была там десять минут до дома.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1089"
                TIME_SLOT_REF1="ts1270" TIME_SLOT_REF2="ts1271">
                <ANNOTATION_VALUE>У нас там был очень хороший парк.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1090"
                TIME_SLOT_REF1="ts1272" TIME_SLOT_REF2="ts1273">
                <ANNOTATION_VALUE>Мы там в основном в парке были.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1091"
                TIME_SLOT_REF1="ts1274" TIME_SLOT_REF2="ts1275">
                <ANNOTATION_VALUE>И ко мне приходили мама с бабушкой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1092"
                TIME_SLOT_REF1="ts1276" TIME_SLOT_REF2="ts1277">
                <ANNOTATION_VALUE>И кормили еду мне.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1093"
                TIME_SLOT_REF1="ts1278" TIME_SLOT_REF2="ts1279">
                <ANNOTATION_VALUE>То есть у них тоже был свой пакетик.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1094"
                TIME_SLOT_REF1="ts1280" TIME_SLOT_REF2="ts1281">
                <ANNOTATION_VALUE>Типа Даша кушает.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1095"
                TIME_SLOT_REF1="ts1282" TIME_SLOT_REF2="ts1283">
                <ANNOTATION_VALUE>И они сами тоже сидели с ребенком.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1096"
                TIME_SLOT_REF1="ts1284" TIME_SLOT_REF2="ts1285">
                <ANNOTATION_VALUE>Вместе сидели.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1097"
                TIME_SLOT_REF1="ts1286" TIME_SLOT_REF2="ts1287">
                <ANNOTATION_VALUE>Но это было достаточно странно,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1098"
                TIME_SLOT_REF1="ts1288" TIME_SLOT_REF2="ts1289">
                <ANNOTATION_VALUE>потому что я говорю с ним на английском.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1099"
                TIME_SLOT_REF1="ts1290" TIME_SLOT_REF2="ts1291">
                <ANNOTATION_VALUE>Они говорят с ним на русском.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1100"
                TIME_SLOT_REF1="ts1292" TIME_SLOT_REF2="ts1293">
                <ANNOTATION_VALUE>И он в итоге молчит просто.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1101"
                TIME_SLOT_REF1="ts1294" TIME_SLOT_REF2="ts1295">
                <ANNOTATION_VALUE>Но мне все очень нравилось.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1102"
                TIME_SLOT_REF1="ts1296" TIME_SLOT_REF2="ts1297">
                <ANNOTATION_VALUE>Я поэтому и скучаю.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1103"
                TIME_SLOT_REF1="ts1298" TIME_SLOT_REF2="ts1299">
                <ANNOTATION_VALUE>А были ли у тебя еще подопечные?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1104"
                TIME_SLOT_REF1="ts1300" TIME_SLOT_REF2="ts1301">
                <ANNOTATION_VALUE>Подопечные? Нет.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1105"
                TIME_SLOT_REF1="ts1302" TIME_SLOT_REF2="ts1303">
                <ANNOTATION_VALUE>У меня было две семьи, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1106"
                TIME_SLOT_REF1="ts1304" TIME_SLOT_REF2="ts1305">
                <ANNOTATION_VALUE>Да, только подопечные.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1107"
                TIME_SLOT_REF1="ts1306" TIME_SLOT_REF2="ts1307">
                <ANNOTATION_VALUE>Расскажи, пожалуйста, есть ли у тебя любимая книжка?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1108"
                TIME_SLOT_REF1="ts1308" TIME_SLOT_REF2="ts1309">
                <ANNOTATION_VALUE>Книжка?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1109"
                TIME_SLOT_REF1="ts1310" TIME_SLOT_REF2="ts1311">
                <ANNOTATION_VALUE>Ну, я читать люблю.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1110"
                TIME_SLOT_REF1="ts1312" TIME_SLOT_REF2="ts1313">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1111"
                TIME_SLOT_REF1="ts1314" TIME_SLOT_REF2="ts1315">
                <ANNOTATION_VALUE>Ну, любимо все это.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1112"
                TIME_SLOT_REF1="ts1316" TIME_SLOT_REF2="ts1317">
                <ANNOTATION_VALUE>Это же сложный вопрос.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1113"
                TIME_SLOT_REF1="ts1318" TIME_SLOT_REF2="ts1319">
                <ANNOTATION_VALUE>Но автор может быть какой-нибудь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1114"
                TIME_SLOT_REF1="ts1320" TIME_SLOT_REF2="ts1321">
                <ANNOTATION_VALUE>На блогов мне нравится.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1115"
                TIME_SLOT_REF1="ts1322" TIME_SLOT_REF2="ts1323">
                <ANNOTATION_VALUE>Я немного у него читала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1116"
                TIME_SLOT_REF1="ts1324" TIME_SLOT_REF2="ts1325">
                <ANNOTATION_VALUE>На ВЛАДу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1117"
                TIME_SLOT_REF1="ts1326" TIME_SLOT_REF2="ts1327">
                <ANNOTATION_VALUE>Ну, такие побайды.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1118"
                TIME_SLOT_REF1="ts1328" TIME_SLOT_REF2="ts1329">
                <ANNOTATION_VALUE>Мне больше все нравится.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1119"
                TIME_SLOT_REF1="ts1330" TIME_SLOT_REF2="ts1331">
                <ANNOTATION_VALUE>Смерть в ВЛАДе и вещах.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1120"
                TIME_SLOT_REF1="ts1332" TIME_SLOT_REF2="ts1333">
                <ANNOTATION_VALUE>Блин, какой-то рассказ про священника забыл.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1121"
                TIME_SLOT_REF1="ts1334" TIME_SLOT_REF2="ts1335">
                <ANNOTATION_VALUE>Отец Сергея.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1122"
                TIME_SLOT_REF1="ts1336" TIME_SLOT_REF2="ts1337">
                <ANNOTATION_VALUE>Сейчас я читаю Щедла.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1123"
                TIME_SLOT_REF1="ts1338" TIME_SLOT_REF2="ts1339">
                <ANNOTATION_VALUE>Ну, как бы, вроде как,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1124"
                TIME_SLOT_REF1="ts1340" TIME_SLOT_REF2="ts1341">
                <ANNOTATION_VALUE>пик популярности прошел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1125"
                TIME_SLOT_REF1="ts1342" TIME_SLOT_REF2="ts1343">
                <ANNOTATION_VALUE>Ну, все-таки он был тогда, наверное, года два-три назад.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1126"
                TIME_SLOT_REF1="ts1344" TIME_SLOT_REF2="ts1345">
                <ANNOTATION_VALUE>Я тогда ее и купила, но она все лежала и лежала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1127"
                TIME_SLOT_REF1="ts1346" TIME_SLOT_REF2="ts1347">
                <ANNOTATION_VALUE>Сосать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1128"
                TIME_SLOT_REF1="ts1348" TIME_SLOT_REF2="ts1349">
                <ANNOTATION_VALUE>Сосать.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1129"
                TIME_SLOT_REF1="ts1350" TIME_SLOT_REF2="ts1351">
                <ANNOTATION_VALUE>Бабай, друзья.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1130"
                TIME_SLOT_REF1="ts1352" TIME_SLOT_REF2="ts1353">
                <ANNOTATION_VALUE>Надо как-то правильно прощаться.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1131"
                TIME_SLOT_REF1="ts1354" TIME_SLOT_REF2="ts1355">
                <ANNOTATION_VALUE>Бабай.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1132"
                TIME_SLOT_REF1="ts1356" TIME_SLOT_REF2="ts1357">
                <ANNOTATION_VALUE>Все, спасибо.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1133"
                TIME_SLOT_REF1="ts1358" TIME_SLOT_REF2="ts1359">
                <ANNOTATION_VALUE>Пока.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
