        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a674"
                TIME_SLOT_REF1="ts410" TIME_SLOT_REF2="ts418">
                <ANNOTATION_VALUE>Вот он решил сделать перекус.</ANNOTATION_VALUE>
