        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a794"
                TIME_SLOT_REF1="ts680" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>Потом мы к моей подруге шли обедать.</ANNOTATION_VALUE>
