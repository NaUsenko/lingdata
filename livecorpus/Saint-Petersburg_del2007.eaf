        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a664"
                TIME_SLOT_REF1="ts306" TIME_SLOT_REF2="ts318">
                <ANNOTATION_VALUE>Подожди, как кролик съел средство?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a665"
                TIME_SLOT_REF1="ts319" TIME_SLOT_REF2="ts328">
                <ANNOTATION_VALUE>По собственному желанию.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a666"
                TIME_SLOT_REF1="ts329" TIME_SLOT_REF2="ts338">
                <ANNOTATION_VALUE>А где он нашел?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a667"
                TIME_SLOT_REF1="ts339" TIME_SLOT_REF2="ts347">
                <ANNOTATION_VALUE>В библиотеке?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a668"
                TIME_SLOT_REF1="ts348" TIME_SLOT_REF2="ts358">
                <ANNOTATION_VALUE>Ну нет, он у меня прыгал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a669"
                TIME_SLOT_REF1="ts359" TIME_SLOT_REF2="ts364">
                <ANNOTATION_VALUE>Которого лета.</ANNOTATION_VALUE>
