        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a670"
                TIME_SLOT_REF1="ts365" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>Во всей квартире он ходил.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a671"
                TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>Ну вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a672"
                TIME_SLOT_REF1="ts384" TIME_SLOT_REF2="ts392">
                <ANNOTATION_VALUE>И залез он как-то под раковину.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a673"
                TIME_SLOT_REF1="ts393" TIME_SLOT_REF2="ts409">
                <ANNOTATION_VALUE>Там лежали всякие губки, таблетки для машины, стирали больше средства.</ANNOTATION_VALUE>
