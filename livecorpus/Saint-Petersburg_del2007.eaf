            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a798"
                TIME_SLOT_REF1="ts688" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>Вот этот бат там все равно было бесплатно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
