        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a681"
                TIME_SLOT_REF1="ts454" TIME_SLOT_REF2="ts455">
                <ANNOTATION_VALUE>Ну хомяка у меня есть сестра.</ANNOTATION_VALUE>
