        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1020"
                TIME_SLOT_REF1="ts1132" TIME_SLOT_REF2="ts1133">
                <ANNOTATION_VALUE>Но первая семья у меня была милая мама, у которой были двояшки, и было по два года.</ANNOTATION_VALUE>
