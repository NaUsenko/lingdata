        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a680"
                TIME_SLOT_REF1="ts452" TIME_SLOT_REF2="ts453">
                <ANNOTATION_VALUE>А хомякинтика, что с ней сделала?</ANNOTATION_VALUE>
