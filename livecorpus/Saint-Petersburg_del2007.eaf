        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a790"
                TIME_SLOT_REF1="ts672" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>Тоже в ежедневную?</ANNOTATION_VALUE>
