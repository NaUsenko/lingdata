            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a796"
                TIME_SLOT_REF1="ts684" TIME_SLOT_REF2="ts685">
