        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a659"
                TIME_SLOT_REF1="ts263" TIME_SLOT_REF2="ts275">
                <ANNOTATION_VALUE>И она нашу черепаху заразила воспалением легким.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a660"
                TIME_SLOT_REF1="ts276" TIME_SLOT_REF2="ts282">
                <ANNOTATION_VALUE>Он тоже сдох.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a661"
                TIME_SLOT_REF1="ts283" TIME_SLOT_REF2="ts291">
                <ANNOTATION_VALUE>Попугай улетел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a662"
                TIME_SLOT_REF1="ts292" TIME_SLOT_REF2="ts297">
                <ANNOTATION_VALUE>Вот так вот.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a663"
                TIME_SLOT_REF1="ts298" TIME_SLOT_REF2="ts305">
                <ANNOTATION_VALUE>Друзья, расскажи мне, как...</ANNOTATION_VALUE>
