        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a675"
                TIME_SLOT_REF1="ts419" TIME_SLOT_REF2="ts428">
                <ANNOTATION_VALUE>И до утра улежал в библиотеке.</ANNOTATION_VALUE>
