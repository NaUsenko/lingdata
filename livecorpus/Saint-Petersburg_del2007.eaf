        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a678"
                TIME_SLOT_REF1="ts441" TIME_SLOT_REF2="ts449">
                <ANNOTATION_VALUE>Нет, у себя в морке коробочка.</ANNOTATION_VALUE>
