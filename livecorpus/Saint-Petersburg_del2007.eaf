        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a689"
                TIME_SLOT_REF1="ts470" TIME_SLOT_REF2="ts471">
                <ANNOTATION_VALUE>Ну не вылежит.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a690"
                TIME_SLOT_REF1="ts472" TIME_SLOT_REF2="ts473">
                <ANNOTATION_VALUE>Это старший сын.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a691"
                TIME_SLOT_REF1="ts474" TIME_SLOT_REF2="ts475">
                <ANNOTATION_VALUE>Наш.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a692"
                TIME_SLOT_REF1="ts476" TIME_SLOT_REF2="ts477">
                <ANNOTATION_VALUE>А брат у тебя старший сын?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a693"
                TIME_SLOT_REF1="ts478" TIME_SLOT_REF2="ts479">
