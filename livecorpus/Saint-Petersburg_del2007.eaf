        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1036"
                TIME_SLOT_REF1="ts1164" TIME_SLOT_REF2="ts1165">
                <ANNOTATION_VALUE>И, как бы, домой всегда на годы я приходила.</ANNOTATION_VALUE>
